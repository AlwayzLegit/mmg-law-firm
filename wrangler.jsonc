{
  // Cloudflare Workers deployment of the Next.js app via OpenNext.
  // See docs/cloudflare-migration-plan.md. Secrets (Supabase, Resend,
  // Turnstile, CRON_SECRET, …) are set with `wrangler secret put`, never here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mmg-law-firm",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // html_handling "none": serve the .html files in public at their own URLs, as Vercel
  // did. The default 307s /x.html → /x, and the v3 guides link the .html.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mmg-law-firm"
    }
  ],
  // Cloudflare Images binding: with it, OpenNext resizes/encodes /_next/image
  // requests (AVIF/WebP at the requested width). Without it the original file
  // is passed through unoptimized, which workstream B measured.
  "images": { "binding": "IMAGES" },
  // The deployed version's id keys the edge page cache (src/lib/cloudflare/
  // page-cache.ts), so a deploy never serves pages that reference the
  // previous build's deleted /_next/static files.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "mmg-law-firm-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }
  ],
  // Same expressions as src/lib/cron/schedules.ts (UTC). A test asserts the
  // two never drift; the Worker's scheduled() maps a fired expression back
  // to its /api/cron route.
  "triggers": {
    "crons": ["0 14 * * 1", "0 15 * * 1-5", "*/15 * * * *", "0 * * * *"]
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.mmg-lawfirm.com"
  },
  // No routes: the public hostnames belong to the front Worker
  // (wrangler.front.jsonc), which calls this one through a service binding.
  // The deploy smoke step and `pnpm parity` use workers.dev (noindexed).
  "workers_dev": true,
  "observability": { "enabled": true },

  // Staging: a separate Worker (`mmg-law-firm-staging`) on
  // staging.mmg-lawfirm.com with its own cache bucket and NO cron triggers —
  // it reads and writes the production Supabase project, so scheduled jobs
  // (breach alerts, agenda email, publish) must only ever run once, from
  // production. Deploy with `wrangler deploy --env staging`. Bindings are
  // repeated here on purpose: wrangler does not inherit them into envs.
  "env": {
    "staging": {
      "name": "mmg-law-firm-staging",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "html_handling": "none"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "mmg-law-firm-staging"
        }
      ],
      "images": { "binding": "IMAGES" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "mmg-law-firm-cache-staging"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
          { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
        ]
      },
      "triggers": { "crons": [] },
      // Must be set: routes are inherited. staging.mmg-lawfirm.com is on the
      // staging front Worker (wrangler.front.jsonc).
      "routes": [],
      "workers_dev": true,
      "vars": {
        "NEXT_PUBLIC_SITE_URL": "https://staging.mmg-lawfirm.com"
      },
      "observability": { "enabled": true }
    }
  }
}
