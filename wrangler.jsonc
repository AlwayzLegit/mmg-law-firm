{
  // Cloudflare Workers deployment of the Next.js app via OpenNext.
  // See docs/cloudflare-migration-plan.md. Secrets (Supabase, Resend,
  // Turnstile, CRON_SECRET, …) are set with `wrangler secret put`, never here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mmg-law-firm",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mmg-law-firm"
    }
  ],
  // Cloudflare Images binding: with it, OpenNext resizes/encodes /_next/image
  // requests (AVIF/WebP at the requested width). Without it the original file
  // is passed through unoptimized, which workstream B measured.
  "images": { "binding": "IMAGES" },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "mmg-law-firm-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }
  ],
  // Same expressions as src/lib/cron/schedules.ts (UTC). A test asserts the
  // two never drift; the Worker's scheduled() maps a fired expression back
  // to its /api/cron route.
  "triggers": {
    "crons": ["0 14 * * 1", "0 15 * * 1-5", "0 * * * *"]
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.mmg-lawfirm.com"
  },
  "observability": { "enabled": true }
}
